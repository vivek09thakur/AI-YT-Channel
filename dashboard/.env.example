# Copy to .env.local for local use; set the same names in the Vercel project for deployment.

# Repo that holds the workflows, as owner/name
GITHUB_REPO=vivek09thakur/AI-YT-Channel

# Fine-grained personal access token for that repo. Pages only read; the /api/trigger route also starts runs, so:
#   Repository permissions: Actions (read and write), Secrets (read), Variables (read),
#   Contents (read), Issues (read), Metadata (read)
GITHUB_TOKEN=github_pat_xxx

# Long random string that signs the login cookie, e.g. the output of: openssl rand -hex 32
AUTH_SECRET=change-me

# Who can sign in. name:password entries separated by commas (an older name:role:password form is still accepted; the role is ignored, everyone is read-only).
# Passwords with "," or ":" in them: use a JSON list instead, [{"user":"vivek","password":"..."}]
DASHBOARD_USERS=vivek:change-me,friend:change-me-too

# External trigger (/api/trigger). Vercel's scheduler (vercel.json > schedules) calls the route with this value as
# "Authorization: Bearer ...". Another long random string, at least 16 characters. Unset = the route answers 503.
# CRON_SECRET=change-me
# Optional second key for any other caller of /api/trigger (cron-job.org, a browser test), same format.
# TRIGGER_SECRET=change-me

# Optional
# VIDEOS_BRANCH=videos
# WORKFLOWS_BRANCH=main
# ACCOUNTS_VARIABLE=DASHBOARD_ACCOUNTS
